# Maintainer: Dopame <dopame@dopame.local>
#
# acdert, the acde runtime (the Dopame desktop base): a Wayland compositor (crates/shell) whose desktop is a web page rendered
# natively (Blitz, crates/render), its JS in acdert's own V8 host (crates/acdert, no Node), with every system interface in
# Rust (crates/runtime, through Node-API on V8), and the login screen. The desktops themselves come from desktop packages (acde-dopame,
# ...) installed under /usr/share/acde/packages. Built from the commit this PKGBUILD belongs to (`git archive HEAD` of
# this repository), so `makepkg` here packages exactly what is committed.
#
# Installed layout:
#   /usr/lib/acdert/acdert             the program: V8, runtime, render and shell in one binary
#   /usr/lib/acdert/app/             acde-host: dist/broker.js and dist/web.js (bundles), greet/ (the login screen:
#                                  `acdert --greeter`, greetd's greeter; user, password and desktop on one page), brand/
#                                  (the Dopame mark and wordmark, for it)
#   /usr/bin/acdert                the session (the script below runs /usr/lib/acdert/acdert, or the Wayland session it
#                                  hands over to: KDE Plasma); `acdert desktops`, `acdert sessions`, `acdert app` / `desktop` (the developer's, run by acde dev)
#   /usr/share/acde/packages/      where desktop packages go (each its own directory)
#   /usr/share/wayland-sessions/acdert.desktop the desktop started last (else the first installed);
#                                  a desktop package installs acdert-<id>.desktop for each of its desktops
#   /usr/lib/tmpfiles.d/acde.conf  /var/lib/acde/greeter: the login screen's state and font cache
#   /etc/xdg/fcitx5/profile        fcitx5's default: English, Ctrl+Space for pinyin
#   /usr/share/xdg-desktop-portal/acde-portals.conf   portals for XDG_CURRENT_DESKTOP=acde: the GTK backend

pkgname=acdert
pkgver=0.0.0
pkgrel=1
pkgdesc='acde runtime: Wayland compositor with natively rendered web desktops, system API and login screen'
# it takes acde-base's place: the same desktop packages (/usr/share/acde/packages), state and session
provides=('acde-base')
conflicts=('acde-base')
arch=('x86_64' 'aarch64')
url='https://github.com/dopame-org/acdert'
license=('Apache-2.0')
depends=(
  # compositor: DRM/KMS, GBM and EGL/GLES (mesa), input, seat, udev; Wayland clients only (no X server)
  'mesa' 'libdrm' 'libinput' 'seatd' 'systemd-libs' 'wayland' 'libxkbcommon'
  # TLS (ntex's, through OpenSSL): the RDP backend (ACDE_BACKEND=rdp) and NLA
  'openssl'
  # the web layer is drawn on the GPU through Vulkan (vello), and only there: CPU devices (lavapipe) are refused, so the
  # GPU's own driver is required (vulkan-intel, vulkan-radeon, nvidia-utils; the Dopame ISO lists them)
  'vulkan-icd-loader' 'vulkan-driver'
  # text: fontconfig and fonts for Latin and CJK
  'fontconfig' 'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji'
  # the pointer under DRM: the shell draws the theme's arrow (default-cursors' `default` inherits Adwaita)
  'adwaita-cursors'
  # system services the shell talks to over D-Bus: network, power, sessions, audio
  'dbus' 'networkmanager' 'upower' 'pipewire' 'wireplumber'
  # input method for the web desktop's text fields (runtime's Ime, D-Bus) and native windows
  'fcitx5' 'fcitx5-chinese-addons' 'fcitx5-gtk' 'fcitx5-qt'
  # native programs the desktop starts: the default terminal, the web browser (a native window of its own: web
  # pages and the Office editor pages open there), the screen locker, opening files with their programs (Finder)
  'foot' 'firefox' 'swaylock' 'xdg-utils'
  # file dialogs and other portals for sandboxed (flatpak / snap) and portal-using apps: the GTK backend
  'xdg-desktop-portal' 'xdg-desktop-portal-gtk'
  # apps' backends run on bun (acde-host backend.ts)
  'bun'
)
optdepends=(
  'acde-dopame: the Dopame desktop and its apps'
  'vulkan-intel: the web layer on Intel GPUs'
  'vulkan-radeon: the web layer on AMD GPUs'
  'nvidia-utils: the web layer on NVIDIA GPUs with the NVIDIA driver'
  'plasma-workspace: KDE Plasma (its plasma.desktop Wayland session) on the login screen, started instead of acdert'
  'docker: ONLYOFFICE Document Server for runtime Office (/usr/lib/acdert/office-ds.sh)'
  'greetd: the login screen (`acdert --greeter` as its greeter; greetd-agreety as the fallback)'
)
makedepends=('git' 'rust' 'bun' 'clang' 'cmake' 'pkgconf' 'python')
options=('!lto' '!debug')
source=()

_repo() {
  realpath -- "${startdir}/../.."
}

# v1.2.3 tags give 1.2.3; commits after a tag (or without one) get .r<count>.g<hash>
pkgver() {
  local desc
  desc=$(git -C "$(_repo)" describe --tags --long --match 'v[0-9]*' 2>/dev/null) ||
    desc="v0.0.0-$(git -C "$(_repo)" rev-list --count HEAD)-g$(git -C "$(_repo)" rev-parse --short HEAD)"
  desc=${desc#v}
  local version=${desc%%-*} rest=${desc#*-}
  local count=${rest%%-*} hash=${rest#*-}
  if [[ $count == 0 ]]; then
    printf '%s\n' "$version"
  else
    printf '%s.r%s.%s\n' "$version" "$count" "$hash"
  fi
}

prepare() {
  rm -rf -- "${srcdir}/acdert"
  mkdir -p -- "${srcdir}/acdert"
  git -c safe.directory='*' -C "$(_repo)" archive --format=tar HEAD | tar -x -C "${srcdir}/acdert"
}

build() {
  cd "${srcdir}/acdert"
  export CARGO_TARGET_DIR="${srcdir}/target"
  # panic messages carry source paths: not the build directory's
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src/acdert"
  cargo build --locked --release -p acdert
  # the bundles: bun only builds them (esbuild); nothing of bun is installed
  cd web
  bun install --frozen-lockfile
  bun run --filter @dopame/acde-host bundle
}

check() {
  # the program starts and answers a command without a display: the Broker's bundle, the packages, the login screen
  ACDE_APP="${srcdir}/acdert/web/packages/acde-host/dist" ACDE_PATH= XDG_DATA_HOME="${srcdir}/check" \
    "${srcdir}/target/release/acdert" desktops --package "${srcdir}/acdert/web/packages/acde-host/greet" | grep -q greet
}

package() {
  install -Dm755 "${srcdir}/target/release/acdert" "${pkgdir}/usr/lib/acdert/acdert"
  local app="${srcdir}/acdert/web/packages/acde-host"
  install -Dm644 -t "${pkgdir}/usr/lib/acdert/app/dist" "$app/dist/broker.js" "$app/dist/web.js"
  install -Dm644 -t "${pkgdir}/usr/lib/acdert/app" "$app/package.json" "$app/LICENSE"
  cp -a -- "$app/greet" "${pkgdir}/usr/lib/acdert/app/greet"
  cp -a -- "$app/brand" "${pkgdir}/usr/lib/acdert/app/brand"
  install -dm755 "${pkgdir}/usr/share/acde/packages"
  install -Dm755 "${srcdir}/acdert/packaging/office/office-ds.sh" "${pkgdir}/usr/lib/acdert/office-ds.sh"
  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/acdert" <<'EOF'
#!/bin/sh
# Commands (`acdert desktops`, `sessions`, `applications`, `open`, `run FILE`, `app ID`, `desktop ID|DIR`, `--help`) are not the session: run as they are, no
# journal redirection, no restart when they fail (a program in the session running `acde --help` once restarted it 3 times)
case "${1:-}" in desktops|sessions|applications|open|run|app|desktop|-h|--help|--version) exec /usr/lib/acdert/acdert "$@" ;; esac
# The Dopame desktop session. Without WAYLAND_DISPLAY or DISPLAY the shell takes the seat and drives DRM/KMS.
# Its output goes to the journal (tag acdert): a display manager such as greetd does not connect the session to it.
# Once: systemd-cat sets JOURNAL_STREAM to the stream it gives us, so the re-run sees it on its stdout and goes on.
if [ "${JOURNAL_STREAM:-}" != "$(stat -L -c %d:%i /proc/$$/fd/1 2>/dev/null)" ] && command -v systemd-cat >/dev/null; then
  exec systemd-cat -t acdert "$0" "$@"
fi
# The login screen: greetd's greeter user has no home (/). Its state (each user's last desktop) and fontconfig's cache
# go to /var/lib/acde/greeter (tmpfiles.d, owned by greeter)
if [ "${1:-}" = --greeter ] && [ -w /var/lib/acde/greeter ]; then
  export XDG_STATE_HOME=/var/lib/acde/greeter/state XDG_CACHE_HOME=/var/lib/acde/greeter/cache
fi
# Input method: fcitx5. Native Wayland clients reach it through text-input-v3 (the shell implements input-method-v2,
# which IBus does not), so no GTK / Qt IM module.
unset GTK_IM_MODULE QT_IM_MODULE XMODIFIERS
# A crash starts the desktop again (one journal line each, tag acdert); the third crash within 60 s gives up, back to
# the display manager (on the live ISO after 10 s). A normal exit (logout) ends the session, and so does a signal to this script (greetd ending it),
# passed on to the desktop. acdert runs in the background to be waited for: `<&0` keeps the session's stdin.
# Exit 3: a Wayland session that is not acde's was chosen (desktops.choose, or remembered); acdert wrote the
# handoff file (line 1: the shell-quoted command; then NAME=value lines, its environment) and this session becomes it.
handoff=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/acde/exec
hand_over() {
  { IFS= read -r line; vars=$(cat); } < "$handoff"
  rm -f "$handoff"
  eval "set -- $line"
  if [ $# -eq 0 ] || ! command -v "$1" >/dev/null 2>&1; then
    logger -t acdert "handoff to ${1:-nothing}: not found"
    return 1
  fi
  logger -t acdert "acdert handed the session over: $*"
  trap - TERM INT HUP
  while IFS= read -r var; do
    case "$var" in [A-Za-z_]*=*) export "$var" ;; esac
  done <<VARS
$vars
VARS
  exec "$@"
}
child=
trap 'kill -TERM "$child" 2>/dev/null; wait "$child"; exit 0' TERM INT HUP
crashes=
while :; do
  rm -f "$handoff"
  /usr/lib/acdert/acdert "$@" <&0 &
  child=$!
  wait "$child"
  status=$?
  [ "$status" -eq 0 ] && exit 0
  [ "$status" -eq 3 ] && [ -s "$handoff" ] && hand_over
  now=$(date +%s)
  recent=$now
  for at in $crashes; do [ $((now - at)) -lt 60 ] && recent="$recent $at"; done
  crashes=$recent
  count=$(echo $crashes | wc -w)
  if [ "$count" -ge 3 ]; then
    logger -t acdert "acdert exited with status $status, $count crashes within 60 s: giving up"
    # the login screen (greetd's greeter): agreety's text prompt instead, on the terminal (stdout is the journal), so
    # that one can still log in; greetd would only start the crashing one again
    if [ "${1:-}" = --greeter ] && command -v agreety >/dev/null && tty=$(tty 2>/dev/null); then
      logger -t acdert "the login screen keeps crashing: agreety instead"
      exec agreety --cmd /usr/bin/acdert <"$tty" >"$tty" 2>&1
    fi
    # the live ISO's greetd starts the desktop again at once (no login): not in a tight loop
    [ -d /run/archiso ] && sleep 10
    exit "$status"
  fi
  logger -t acdert "acdert exited with status $status: starting it again ($count within 60 s)"
done
EOF
  # the login screen's state and font cache (greetd's greeter user; without that user the line is skipped with a warning)
  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/tmpfiles.d/acde.conf" <<'EOF'
d /var/lib/acde/greeter 0700 greeter greeter -
EOF
  # fcitx5's system default profile (a user's ~/.config/fcitx5/profile wins): typing starts in English (keyboard-us),
  # Ctrl+Space switches to pinyin. Without it a new user only has keyboard-us and cannot type Chinese.
  install -Dm644 /dev/stdin "${pkgdir}/etc/xdg/fcitx5/profile" <<'EOF'
[Groups/0]
# Group Name
Name=Default
# Layout
Default Layout=us
# Default Input Method
DefaultIM=pinyin

[Groups/0/Items/0]
# Name
Name=keyboard-us
# Layout
Layout=

[Groups/0/Items/1]
# Name
Name=pinyin
# Layout
Layout=

[GroupOrder]
0=Default
EOF
  # xdg-desktop-portal picks backends by XDG_CURRENT_DESKTOP (the shell exports acde to the user's systemd and D-Bus
  # environment); without this file it finds none for acde and apps get no file chooser
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/xdg-desktop-portal/acde-portals.conf" <<'EOF'
[preferred]
default=gtk
EOF
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/wayland-sessions/acdert.desktop" <<'EOF'
[Desktop Entry]
Name=Dopame
Comment=Dopame desktop (acdert): the desktop started last, else the first installed
Exec=/usr/bin/acdert
Type=Application
DesktopNames=acde
EOF
}
