{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dopame-org/acdert/web/packages/acde-api/config.schema.json",
  "title": "acde.config.jsonc",
  "description": "acde 工程的配置: 一个窗口应用 (type app) 或一个桌面 (type desktop); acde app build 把它变成包的 package.json 清单",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "包名, 默认 package.json 的 name"
        },
        "version": {
          "type": "string"
        },
        "apiLevel": {
          "type": "integer",
          "minimum": 1,
          "description": "契约级别 (SDK 的 API_LEVEL); 不写时 acde build 写入当前级别"
        },
        "public": {
          "type": "string",
          "description": "原样复制的静态文件目录, 默认 public"
        },
        "type": {
          "const": "app"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "entry": {
          "type": "string",
          "description": "HTML 页面 (默认 index.html) 或默认导出 WindowApp 的模块; 认出框架时不用"
        },
        "framework": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "next",
            "nuxt",
            "sveltekit",
            "astro",
            "react-router",
            "remix",
            "angular",
            "vite",
            "cra",
            "script"
          ],
          "description": "怎么构建: auto (默认) 按依赖认框架 (Next.js、Nuxt、SvelteKit、Astro、React Router、Remix、Angular、Vite、Create React App, 或 package.json 的 build 脚本) 并用它自己的构建; none 用 acde 自己的打包 (Bun.build, entry 是 HTML 或模块)"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "fs": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "roots": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "roots"
                  ]
                }
              ]
            },
            "terminal": {
              "type": "boolean"
            },
            "office": {
              "type": "boolean"
            },
            "launch": {
              "type": "boolean"
            },
            "slots": {
              "type": "boolean"
            },
            "open": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "openFiles": {
              "type": "boolean"
            },
            "session": {
              "type": "boolean",
              "description": "acde:session (注销, 语言 …; 外壳模块, 只给系统应用)"
            },
            "desktops": {
              "type": "boolean",
              "description": "acde:desktops (列出 / 切换桌面; 外壳模块, 只给系统应用)"
            },
            "windows": {
              "type": "boolean",
              "description": "acde:windows (所有窗口: 列出、聚焦、隐藏、动画; 外壳模块, 只给系统应用)"
            },
            "packages": {
              "type": "boolean",
              "description": "acde:packages (刷新、安装包, 列出和运行原生程序; 外壳模块, 只给系统应用)"
            },
            "inspect": {
              "type": "boolean",
              "description": "acde:inspect (看和操作桌面; 外壳模块, 只给系统应用)"
            },
            "desktop": {
              "type": "boolean",
              "description": "acde:desktop (桌面事件和钉住的面板; 外壳模块, 只给系统应用)"
            },
            "setDefault": {
              "type": "boolean",
              "description": "acde:setDefault (设默认应用; 外壳模块, 只给系统应用)"
            },
            "camera": {
              "type": "boolean",
              "description": "navigator.mediaDevices.getUserMedia 的摄像头 (还要系统同意: macOS 隐私设置)"
            },
            "microphone": {
              "type": "boolean",
              "description": "navigator.mediaDevices.getUserMedia 的麦克风 (还要系统同意: macOS 隐私设置)"
            }
          },
          "additionalProperties": true,
          "description": "acde 的能力; 别的键是桌面服务的名字"
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "capabilities 里可以缺的几项 (每项也要写在 capabilities 里); 其余都是必需的, 缺了应用不进列表、启动时被拒"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "用到的桌面服务名 (照旧 import acde:<名字>); 不能用系统模块的名字"
        },
        "heapMb": {
          "type": "number",
          "minimum": 32
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "窗口的默认尺寸 [宽, 高], 逻辑像素; 默认 800x600"
        },
        "multiple": {
          "type": "boolean"
        },
        "frame": {
          "type": "boolean"
        },
        "mimeTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backend": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "entry": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "false: 没有后端; 默认找 server.ts 等"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "包名, 默认 package.json 的 name"
        },
        "version": {
          "type": "string"
        },
        "apiLevel": {
          "type": "integer",
          "minimum": 1,
          "description": "契约级别 (SDK 的 API_LEVEL); 不写时 acde build 写入当前级别"
        },
        "public": {
          "type": "string",
          "description": "原样复制的静态文件目录, 默认 public"
        },
        "type": {
          "const": "desktop"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entry": {
          "type": "string",
          "description": "桌面页面, 默认 index.html"
        },
        "heapMb": {
          "type": "number",
          "minimum": 32
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "服务名 → 模块"
        },
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "$ref": "#/$defs/icon"
              },
              "entry": {
                "type": "string",
                "description": "HTML 页面 (默认 index.html) 或默认导出 WindowApp 的模块"
              },
              "capabilities": {
                "type": "object",
                "properties": {
                  "fs": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "roots": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "roots"
                        ]
                      }
                    ]
                  },
                  "terminal": {
                    "type": "boolean"
                  },
                  "office": {
                    "type": "boolean"
                  },
                  "launch": {
                    "type": "boolean"
                  },
                  "slots": {
                    "type": "boolean"
                  },
                  "open": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "openFiles": {
                    "type": "boolean"
                  },
                  "session": {
                    "type": "boolean",
                    "description": "acde:session (注销, 语言 …; 外壳模块, 只给系统应用)"
                  },
                  "desktops": {
                    "type": "boolean",
                    "description": "acde:desktops (列出 / 切换桌面; 外壳模块, 只给系统应用)"
                  },
                  "windows": {
                    "type": "boolean",
                    "description": "acde:windows (所有窗口: 列出、聚焦、隐藏、动画; 外壳模块, 只给系统应用)"
                  },
                  "packages": {
                    "type": "boolean",
                    "description": "acde:packages (刷新、安装包, 列出和运行原生程序; 外壳模块, 只给系统应用)"
                  },
                  "inspect": {
                    "type": "boolean",
                    "description": "acde:inspect (看和操作桌面; 外壳模块, 只给系统应用)"
                  },
                  "desktop": {
                    "type": "boolean",
                    "description": "acde:desktop (桌面事件和钉住的面板; 外壳模块, 只给系统应用)"
                  },
                  "setDefault": {
                    "type": "boolean",
                    "description": "acde:setDefault (设默认应用; 外壳模块, 只给系统应用)"
                  },
                  "camera": {
                    "type": "boolean",
                    "description": "navigator.mediaDevices.getUserMedia 的摄像头 (还要系统同意: macOS 隐私设置)"
                  },
                  "microphone": {
                    "type": "boolean",
                    "description": "navigator.mediaDevices.getUserMedia 的麦克风 (还要系统同意: macOS 隐私设置)"
                  }
                },
                "additionalProperties": true,
                "description": "acde 的能力; 别的键是桌面服务的名字"
              },
              "optional": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "capabilities 里可以缺的几项 (每项也要写在 capabilities 里); 其余都是必需的, 缺了应用不进列表、启动时被拒"
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "用到的桌面服务名 (照旧 import acde:<名字>); 不能用系统模块的名字"
              },
              "heapMb": {
                "type": "number",
                "minimum": 32
              },
              "size": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "窗口的默认尺寸 [宽, 高], 逻辑像素; 默认 800x600"
              },
              "multiple": {
                "type": "boolean"
              },
              "frame": {
                "type": "boolean"
              },
              "mimeTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "backend": {
                "oneOf": [
                  {
                    "const": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "entry": {
                        "type": "string"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "false: 没有后端; 默认找 server.ts 等"
              }
            },
            "required": [
              "id",
              "entry"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "icon": {
      "type": "string",
      "minLength": 1,
      "description": "图标: Dopame 的图标名 (@dopame/acde-api/manifest 的 ICON_NAMES 之一: files, browser, editor, office, term, projects, dash, team, dopa, settings, store, app, timer, cards, list, chart, calc, music, video, photo, paint, game, chat, mail, calendar, code, book, map, weather), 或工程里的一张图片 (.svg / .png, 相对工程目录, acde build 拷进包里); 别的值 acde check 警告",
      "examples": [
        "files",
        "browser",
        "editor",
        "office",
        "term",
        "projects",
        "dash",
        "team",
        "dopa",
        "settings",
        "store",
        "app",
        "timer",
        "cards",
        "list",
        "chart",
        "calc",
        "music",
        "video",
        "photo",
        "paint",
        "game",
        "chat",
        "mail",
        "calendar",
        "code",
        "book",
        "map",
        "weather",
        "icon.svg"
      ]
    }
  }
}
