{
  "$schema": "./node_modules/@dopame/acde-api/config.schema.json",
  // 窗口应用: {{framework}} 工程, acde build 用它自己的构建. 系统能力从 acde:* 模块导入 (import { fs } from 'acde:fs'), 按 capabilities 给;
  // 编辑器里的类型写 /// <reference types="@dopame/acde-api/app" /> (应用层的模块; 外壳模块只给桌面和它自带的应用).
  "type": "app",
  "id": "{{id}}",
  "label": "{{label}}",
  // icon: 图标名 (app、timer、chart … 见 @dopame/acde-api) 或工程里的一张 .svg / .png (如 "icon.svg"), 构建时复制进包.
  "icon": "app",
  // capabilities: 用到的系统能力. "fs": true 给本应用的私有文件夹和用户选给它的文件夹; 要公共位置时在 fs.roots 里点名,
  // 每个位置由用户批准: "fs": { "roots": ["documents"] } (desktop、documents、downloads、music、pictures、videos).
  "capabilities": {},
  // optional: capabilities 里缺了也能运行的几项; 它们不静态导入, 经 @dopame/acde-api 的 load('<名字>') 拿.
  "optional": [],
  // services: 用到的桌面服务名 (import 'acde:<名字>'), 不能用系统模块的名字.
  "services": [],
  // requests: 接受的私有请求 (别的应用 open('{{id}}', { kind: '<名字>' })); schemes: 打开哪些 URL scheme 的链接 (小写, 不带冒号).
  "requests": [],
  "schemes": []
}
