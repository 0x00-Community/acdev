{
  "$schema": "./node_modules/@dopame/acde-api/config.schema.json",
  // 桌面: 一张满屏网页, 在所有窗口后面. 系统能力从 acde:* 模块导入, 应用层和外壳层的模块都有;
  // 编辑器里的类型写 /// <reference types="@dopame/acde-api/shell" />.
  "type": "desktop",
  "id": "{{id}}",
  "label": "{{label}}",
  "entry": "index.html",
  // services: 跑在 acde 里的桌面服务 (名字 → 模块). 服务名不能用系统模块的名字; 服务经 ctx.import('acde:<名字>') 拿外壳模块.
  "services": {},
  // apps: 这个桌面自带的窗口应用 (系统应用), 每个和 "type": "app" 的工程一样写 capabilities、optional、services、requests、schemes,
  // 另外可以声明外壳模块 (如 "windows": true).
  "apps": []
}
