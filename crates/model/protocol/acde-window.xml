<?xml version="1.0" encoding="UTF-8"?>
<protocol name="acde_window">
  <copyright>
    Copyright dopamine-org. Apache-2.0.
  </copyright>

  <interface name="acde_window_manager" version="1">
    <description summary="what only acde knows about a window">
      The framework's side of an xdg_toplevel: the window it is in acde's window table, its mode, the backdrop
      under it, where it can be grabbed, input grabs and activation. Everything else is the standard protocols.
    </description>

    <request name="destroy" type="destructor"/>

    <request name="get_window">
      <description summary="the acde side of a toplevel's surface"/>
      <arg name="id" type="new_id" interface="acde_window"/>
      <arg name="surface" type="object" interface="wl_surface"/>
    </request>
  </interface>

  <interface name="acde_window" version="1">
    <enum name="mode">
      <entry name="fullscreen" value="0"/>
      <entry name="free" value="1"/>
      <entry name="fixed" value="2"/>
      <entry name="pinned" value="3"/>
    </enum>

    <enum name="edges" bitfield="true">
      <entry name="none" value="0"/>
      <entry name="top" value="1"/>
      <entry name="bottom" value="2"/>
      <entry name="left" value="4"/>
      <entry name="right" value="8"/>
    </enum>

    <enum name="grab_kind">
      <entry name="pointer" value="1"/>
      <entry name="keyboard" value="2"/>
    </enum>

    <enum name="grab_lost_reason">
      <entry name="esc" value="0"/>
      <entry name="other_window" value="1"/>
      <entry name="focus_lost" value="2"/>
      <entry name="denied" value="3"/>
    </enum>

    <request name="destroy" type="destructor"/>

    <request name="bind">
      <description summary="claim the window the broker granted under this token"/>
      <arg name="token_hi" type="uint"/>
      <arg name="token_lo" type="uint"/>
    </request>

    <request name="request_mode">
      <arg name="mode" type="uint" enum="mode"/>
    </request>

    <request name="set_backdrop">
      <description summary="filter what is under this rect (window-local, physical pixels) first; an empty rect cancels"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
      <arg name="radius" type="fixed"/>
      <arg name="blur" type="fixed"/>
      <arg name="saturate" type="fixed"/>
      <arg name="brightness" type="fixed"/>
    </request>

    <request name="set_grab_hint">
      <description summary="a pointer press in this rect (window-local, logical) moves the window, or resizes it at these edges; the latest hint wins where they overlap; an empty rect clears them all"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
      <arg name="edges" type="uint" enum="edges"/>
    </request>

    <request name="request_grab">
      <arg name="kind" type="uint" enum="grab_kind"/>
    </request>

    <request name="release_grab">
      <description summary="give back a grab this window holds; no grab_lost follows"/>
      <arg name="kind" type="uint" enum="grab_kind"/>
    </request>
    <request name="request_activate"/>

    <event name="window">
      <description summary="the window this surface is in the window table (after bind)"/>
      <arg name="id" type="uint"/>
    </event>

    <event name="mode">
      <arg name="mode" type="uint" enum="mode"/>
    </event>

    <event name="grab">
      <arg name="granted" type="uint"/>
      <arg name="kind" type="uint" enum="grab_kind"/>
    </event>

    <event name="grab_lost">
      <arg name="reason" type="uint" enum="grab_lost_reason"/>
    </event>
  </interface>
</protocol>
