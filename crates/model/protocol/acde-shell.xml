<?xml version="1.0" encoding="UTF-8"?>
<protocol name="acde_shell">
  <copyright>
    Copyright dopamine-org. Apache-2.0.
  </copyright>

  <interface name="acde_shell" version="1">
    <description summary="the Broker's control of the compositor">
      What the napi Shell does, as a protocol: the compositor offers it only on the connection the main process
      hands the Broker. Window ids are the compositor's window table ids; coordinates are canvas logical pixels;
      a -1 int means none. The replies of list, stats, screenshot, shortcut and launch come on the callback object
      the request makes.
    </description>

    <enum name="mode">
      <entry name="fullscreen" value="0"/>
      <entry name="free" value="1"/>
      <entry name="fixed" value="2"/>
      <entry name="pinned" value="3"/>
    </enum>

    <enum name="scope">
      <entry name="session" value="0"/>
      <entry name="desktop" value="1"/>
      <entry name="app" value="2"/>
    </enum>

    <enum name="wheel_source">
      <entry name="wheel" value="0"/>
      <entry name="finger" value="1"/>
      <entry name="continuous" value="2"/>
    </enum>

    <enum name="easing">
      <entry name="linear" value="0"/>
      <entry name="ease" value="1"/>
      <entry name="ease_in" value="2"/>
      <entry name="ease_out" value="3"/>
      <entry name="ease_in_out" value="4"/>
    </enum>

    <enum name="animated" bitfield="true">
      <entry name="opacity" value="1"/>
      <entry name="scale" value="2"/>
      <entry name="dx" value="4"/>
      <entry name="dy" value="8"/>
      <entry name="easing" value="16"/>
    </enum>

    <request name="grant">
      <description summary="a token a web process claims its window with (acde_window.bind)"/>
      <arg name="token_hi" type="uint"/>
      <arg name="token_lo" type="uint"/>
      <arg name="window" type="uint"/>
      <arg name="desktop" type="uint"/>
      <arg name="mode" type="uint" enum="mode"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int" summary="0: no rect"/>
      <arg name="height" type="int"/>
      <arg name="size_width" type="int" summary="0: no size"/>
      <arg name="size_height" type="int"/>
    </request>

    <request name="release">
      <arg name="window" type="uint"/>
    </request>

    <request name="focus">
      <arg name="window" type="uint"/>
    </request>

    <request name="hide">
      <arg name="window" type="uint"/>
      <arg name="hidden" type="uint"/>
    </request>

    <request name="close">
      <arg name="window" type="uint"/>
    </request>

    <request name="place">
      <arg name="window" type="uint"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </request>

    <request name="raise">
      <arg name="window" type="uint"/>
      <arg name="above" type="int"/>
    </request>

    <request name="set_mode">
      <arg name="window" type="uint"/>
      <arg name="mode" type="uint" enum="mode"/>
    </request>

    <request name="list">
      <arg name="callback" type="new_id" interface="acde_shell_list"/>
    </request>

    <request name="stats">
      <arg name="reset" type="uint"/>
      <arg name="callback" type="new_id" interface="acde_shell_stats"/>
    </request>

    <request name="screenshot">
      <arg name="path" type="string"/>
      <arg name="callback" type="new_id" interface="acde_shell_result"/>
    </request>

    <request name="inject_move">
      <arg name="x" type="fixed"/>
      <arg name="y" type="fixed"/>
    </request>

    <request name="inject_motion">
      <arg name="dx" type="fixed"/>
      <arg name="dy" type="fixed"/>
    </request>

    <request name="inject_button">
      <arg name="button" type="uint"/>
      <arg name="pressed" type="uint"/>
    </request>

    <request name="inject_wheel">
      <arg name="dx" type="fixed"/>
      <arg name="dy" type="fixed"/>
      <arg name="source" type="uint" enum="wheel_source"/>
    </request>

    <request name="inject_key">
      <arg name="code" type="uint"/>
      <arg name="pressed" type="uint"/>
    </request>

    <request name="animate">
      <arg name="window" type="uint"/>
      <arg name="given" type="uint" enum="animated"/>
      <arg name="opacity" type="fixed"/>
      <arg name="scale" type="fixed"/>
      <arg name="dx" type="fixed"/>
      <arg name="dy" type="fixed"/>
      <arg name="duration_ms" type="uint"/>
      <arg name="delay_ms" type="uint"/>
      <arg name="easing" type="uint" enum="easing"/>
    </request>

    <request name="shortcut">
      <arg name="combo" type="string"/>
      <arg name="scope" type="uint" enum="scope"/>
      <arg name="owner" type="uint"/>
      <arg name="callback" type="new_id" interface="acde_shell_result"/>
    </request>

    <request name="unshortcut">
      <arg name="combo" type="string"/>
      <arg name="scope" type="uint" enum="scope"/>
      <arg name="owner" type="uint"/>
    </request>

    <request name="launch">
      <description summary="a native program started by the compositor (its WAYLAND_DISPLAY, without DISPLAY)">
        argv and env are NUL-terminated strings back to back; env's are key=value. cwd empty: the compositor's.
      </description>
      <arg name="argv" type="array"/>
      <arg name="cwd" type="string"/>
      <arg name="env" type="array"/>
      <arg name="callback" type="new_id" interface="acde_shell_result"/>
    </request>

    <request name="quit">
      <description summary="the compositor stops; the connection closes when it has"/>
    </request>

    <event name="output">
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
      <arg name="scale" type="fixed"/>
    </event>

    <event name="window_open">
      <arg name="window" type="uint"/>
      <arg name="title" type="string" allow-null="true"/>
      <arg name="app_id" type="string" allow-null="true"/>
    </event>

    <event name="window_close">
      <arg name="window" type="int"/>
    </event>

    <event name="window_title">
      <arg name="window" type="int"/>
      <arg name="title" type="string" allow-null="true"/>
      <arg name="app_id" type="string" allow-null="true"/>
    </event>

    <event name="window_fullscreen">
      <arg name="window" type="uint"/>
      <arg name="fullscreen" type="uint"/>
    </event>

    <event name="window_minimize">
      <arg name="window" type="int"/>
    </event>

    <event name="window_activate">
      <arg name="window" type="int"/>
    </event>

    <event name="window_animated">
      <arg name="window" type="uint"/>
    </event>

    <event name="shortcut">
      <arg name="owner" type="uint"/>
      <arg name="key" type="string" allow-null="true"/>
      <arg name="scope" type="uint" enum="scope"/>
    </event>

    <event name="window_gone">
      <arg name="window" type="int"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </event>

    <event name="window_min_size">
      <arg name="window" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </event>

    <event name="window_parent">
      <arg name="window" type="uint"/>
      <arg name="parent" type="int"/>
    </event>

    <event name="milestone">
      <arg name="title" type="string"/>
      <arg name="time_ms" type="fixed"/>
    </event>

    <event name="input_target">
      <arg name="window" type="int"/>
      <arg name="x" type="fixed"/>
      <arg name="y" type="fixed"/>
      <arg name="button" type="uint"/>
    </event>
  </interface>

  <interface name="acde_shell_list" version="1">
    <description summary="the reply of acde_shell.list: the windows, the canvases, then done (and gone)"/>

    <event name="window">
      <arg name="id" type="uint"/>
      <arg name="window" type="int"/>
      <arg name="canvas" type="uint"/>
      <arg name="mode" type="uint" enum="acde_shell.mode"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="uint"/>
      <arg name="height" type="uint"/>
      <arg name="z" type="int"/>
      <arg name="focus" type="uint"/>
      <arg name="hidden" type="uint"/>
      <arg name="pid" type="int"/>
    </event>

    <event name="canvas">
      <arg name="id" type="uint"/>
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="uint"/>
      <arg name="height" type="uint"/>
      <arg name="scale" type="fixed"/>
    </event>

    <event name="done" type="destructor"/>
  </interface>

  <interface name="acde_shell_stats" version="1">
    <description summary="the reply of acde_shell.stats (then gone); the times in milliseconds"/>

    <event name="done" type="destructor">
      <arg name="frames" type="uint"/>
      <arg name="compose_p50" type="fixed"/>
      <arg name="compose_p95" type="fixed"/>
      <arg name="compose_max" type="fixed"/>
      <arg name="plans" type="uint"/>
      <arg name="direct" type="uint"/>
    </event>
  </interface>

  <interface name="acde_shell_result" version="1">
    <description summary="the reply of a request that can fail (then gone): done with its values, or failed"/>

    <event name="done" type="destructor">
      <arg name="first" type="uint" summary="screenshot: width; launch: pid; shortcut: 0"/>
      <arg name="second" type="uint" summary="screenshot: height; else 0"/>
    </event>

    <event name="failed" type="destructor">
      <arg name="message" type="string"/>
    </event>
  </interface>
</protocol>
