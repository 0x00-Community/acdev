{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dopamine-org/acde-base/js/packages/acde-api/config.schema.json",
  "title": "acde.config.jsonc",
  "description": "acde 工程的配置: 一个窗口应用 (type app) 或一个桌面 (type desktop); acde app build 把它变成包的 package.json 清单",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "包名, 默认 package.json 的 name"
        },
        "version": {
          "type": "string"
        },
        "public": {
          "type": "string",
          "description": "原样复制的静态文件目录, 默认 public"
        },
        "type": {
          "const": "app"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "Material Symbols 名字"
        },
        "entry": {
          "type": "string",
          "description": "HTML 页面 (默认 index.html) 或默认导出 WindowApp 的模块; 认出框架时不用"
        },
        "framework": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "next",
            "nuxt",
            "sveltekit",
            "astro",
            "react-router",
            "remix",
            "angular",
            "vite",
            "cra",
            "script"
          ],
          "description": "怎么构建: auto (默认) 按依赖认框架 (Next.js、Nuxt、SvelteKit、Astro、React Router、Remix、Angular、Vite、Create React App, 或 package.json 的 build 脚本) 并用它自己的构建; none 用 acde 自己的打包 (Bun.build, entry 是 HTML 或模块)"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "fs": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "roots": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "roots"
                  ]
                }
              ]
            },
            "terminal": {
              "type": "boolean"
            },
            "office": {
              "type": "boolean"
            },
            "launch": {
              "type": "boolean"
            },
            "slots": {
              "type": "boolean"
            },
            "open": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "openFiles": {
              "type": "boolean"
            },
            "session": {
              "type": "boolean",
              "description": "acde:session (注销, 语言 …)"
            },
            "desktops": {
              "type": "boolean",
              "description": "acde:desktops (列出 / 切换桌面)"
            }
          },
          "additionalProperties": true,
          "description": "acde 的能力; 别的键是桌面服务的名字"
        },
        "heapMb": {
          "type": "number",
          "minimum": 32
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "窗口的默认尺寸 [宽, 高], 逻辑像素; 默认 800x600"
        },
        "multiple": {
          "type": "boolean"
        },
        "frame": {
          "type": "boolean"
        },
        "mimeTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backend": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "entry": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "false: 没有后端; 默认找 server.ts 等"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "包名, 默认 package.json 的 name"
        },
        "version": {
          "type": "string"
        },
        "public": {
          "type": "string",
          "description": "原样复制的静态文件目录, 默认 public"
        },
        "type": {
          "const": "desktop"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entry": {
          "type": "string",
          "description": "桌面页面, 默认 index.html"
        },
        "heapMb": {
          "type": "number",
          "minimum": 32
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "服务名 → 模块"
        },
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "Material Symbols 名字"
              },
              "entry": {
                "type": "string",
                "description": "HTML 页面 (默认 index.html) 或默认导出 WindowApp 的模块"
              },
              "capabilities": {
                "type": "object",
                "properties": {
                  "fs": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "roots": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "roots"
                        ]
                      }
                    ]
                  },
                  "terminal": {
                    "type": "boolean"
                  },
                  "office": {
                    "type": "boolean"
                  },
                  "launch": {
                    "type": "boolean"
                  },
                  "slots": {
                    "type": "boolean"
                  },
                  "open": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "openFiles": {
                    "type": "boolean"
                  },
                  "session": {
                    "type": "boolean",
                    "description": "acde:session (注销, 语言 …)"
                  },
                  "desktops": {
                    "type": "boolean",
                    "description": "acde:desktops (列出 / 切换桌面)"
                  }
                },
                "additionalProperties": true,
                "description": "acde 的能力; 别的键是桌面服务的名字"
              },
              "heapMb": {
                "type": "number",
                "minimum": 32
              },
              "size": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "窗口的默认尺寸 [宽, 高], 逻辑像素; 默认 800x600"
              },
              "multiple": {
                "type": "boolean"
              },
              "frame": {
                "type": "boolean"
              },
              "mimeTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "backend": {
                "oneOf": [
                  {
                    "const": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "entry": {
                        "type": "string"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "false: 没有后端; 默认找 server.ts 等"
              }
            },
            "required": [
              "id",
              "entry"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
