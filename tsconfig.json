{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "allowJs": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "launcher.mjs",
    "bin",
    "packages"
  ],
  "exclude": [
    "test/fixtures"
  ]
}
